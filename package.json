{
  "name": "voxly-pro",
  "version": "2.0.0",
  "description": "Advanced Social Listening & Analytics Platform",
  "private": true,
  "scripts": {
    "dev": "npm --prefix server run dev",
    "start": "npm --prefix server run start",
    "install:all": "npm --prefix server install",
    "db:up": "docker-compose up -d",
    "db:down": "docker-compose down",
    "db:migrate": "npm --prefix server run db:migrate",
    "db:generate": "npm --prefix server run db:generate",
    "db:reset": "npm --prefix server run db:reset",
    "db:studio": "npm --prefix server run db:studio",
    "seed": "npm --prefix server run seed",
    "setup": "docker-compose up -d && npm --prefix server install && npm --prefix server run db:migrate && npm --prefix server run seed",
    "test": "npm --prefix server test"
  },
  "keywords": [
    "social-listening",
